# Copy the exact Session pooler host/username from YOUR project's Connect dialog.
# Replace placeholders locally, percent-encode reserved password characters.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_DATABASE_PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=require
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional compatibility alias when ANTHROPIC_MODEL is unset:
COACH_MODEL=
VISUALIZE_SECRET_KEY=
VISUALIZE_API_BASE_URL=https://api.visualizeme.ai
DEMO_API_TOKEN=REPLACE_WITH_RANDOM_TEMPORARY_TOKEN
DEMO_USER_ID=1
VISUALIZE_HOST_USER_REF=milo_demo_1
APP_TIMEZONE=America/New_York
